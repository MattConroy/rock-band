@* Step 2: connect PlayStation by pasting an npsso once. Owns its own input state. *@

<StepCard Number="2" Title="Connect PlayStation">
    @if (Connected)
    {
        <p class="rb-muted">
            Connected.
            @if (Library is { Songs.Count: > 0 })
            {
                <span><strong>@Library.Songs.Count</strong> songs@(string.IsNullOrEmpty(Library.GeneratedAt) ? "" : $" · fetched {FormatWhen(Library.GeneratedAt)}").</span>
            }
        </p>
        <div class="rb-row-actions">
            <button class="rb-btn" @onclick="OnFetch" disabled="@Fetching">
                @(Fetching ? "Fetching…" : (Library is null ? "Fetch my songs" : "Refresh from PSN"))
            </button>
            <button class="rb-btn rb-btn-secondary" @onclick="OnDisconnect" disabled="@Fetching">Disconnect</button>
        </div>

        @if (Library is { Songs.Count: > 0 })
        {
            <details class="songs-list">
                <summary>Show @Library.Songs.Count fetched songs</summary>
                <ul>
                    @foreach (var s in Library.Songs)
                    {
                        <li>
                            @s.Song
                            <span class="rb-sub">— @s.Artist</span>
                        </li>
                    }
                </ul>
            </details>
        }

        <details class="debug-box">
            <summary>Debug: raw entitlements</summary>
            <p class="rb-sub">The content codes PlayStation reports for your account. Useful when a song you own is missing: it will be a code the catalogue has no id for.</p>
            <button class="rb-btn rb-btn-secondary" @onclick="OnLoadRaw" disabled="@LoadingRaw">
                @(LoadingRaw ? "Loading…" : "Load raw entitlements")
            </button>
            @if (RawDebug is not null)
            {
                <pre class="debug-pre">@RawDebug</pre>
            }
        </details>
    }
    else
    {
        <p class="rb-muted">
            The browser can't read PlayStation directly, so this uses your stateless gateway.
            Your token is cached in this browser and lasts about two months.
        </p>

        <div class="flow-step">
            <div class="flow-label">1 · Log in to PlayStation</div>
            <a class="rb-btn login-link" href="@SsoUrl" target="_blank" rel="noopener">Open PlayStation login ↗</a>
            <p class="rb-sub">Sign in — the page then shows <code>{"npsso":"…"}</code>.</p>
        </div>

        <div class="flow-step">
            <div class="flow-label">2 · Paste the token</div>
            <div class="rb-row-actions">
                <input class="rb-select token-input" type="password"
                       placeholder="paste npsso value" @bind="_token" @bind:event="oninput" />
                <button class="rb-btn" @onclick="ConnectAsync"
                        disabled="@(Fetching || string.IsNullOrWhiteSpace(_token) || !GatewayConfigured)">
                    @(Fetching ? "Connecting…" : "Connect & fetch")
                </button>
            </div>
            <p class="rb-sub">
                Copy <strong>only</strong> the value between the quotes after <code>"npsso":</code>
                — not the braces or quotes.
            </p>
        </div>
    }

    @if (Error is not null)
    {
        <div class="rb-alert rb-alert-bad error">@Error</div>
    }
</StepCard>

@code {
    [Parameter, EditorRequired] public bool Connected { get; set; }
    [Parameter] public SongLibrary? Library { get; set; }
    [Parameter, EditorRequired] public bool Fetching { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter, EditorRequired] public bool GatewayConfigured { get; set; }
    [Parameter, EditorRequired] public string SsoUrl { get; set; } = "";
    [Parameter] public string? RawDebug { get; set; }
    [Parameter] public bool LoadingRaw { get; set; }
    [Parameter] public EventCallback<string> OnConnect { get; set; }
    [Parameter] public EventCallback OnFetch { get; set; }
    [Parameter] public EventCallback OnDisconnect { get; set; }
    [Parameter] public EventCallback OnLoadRaw { get; set; }

    private string _token = "";

    private async Task ConnectAsync()
    {
        var token = _token;
        _token = "";
        await OnConnect.InvokeAsync(token);
    }

    private static string FormatWhen(string iso)
        => DateTimeOffset.TryParse(iso, out var dt) ? dt.LocalDateTime.ToString("g") : iso;
}
