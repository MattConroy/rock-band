@* Shown until Spotify and the PSN gateway are both configured. *@

@if (!SpotifyConfigured || !GatewayConfigured)
{
    <div class="rb-card">
        <div class="rb-alert rb-alert-warn">
            <strong>Setup needed.</strong>
            @if (!SpotifyConfigured)
            {
                <div>• Add your Spotify <code>ClientId</code> and register redirect URI <code>@RedirectUri</code> (Spotify dashboard).</div>
            }
            @if (!GatewayConfigured)
            {
                <div>• Deploy the gateway Worker and set <code>Psn.GatewayUrl</code> in <code>appsettings.json</code>.</div>
            }
            See the README.
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool SpotifyConfigured { get; set; }
    [Parameter, EditorRequired] public bool GatewayConfigured { get; set; }
    [Parameter] public string RedirectUri { get; set; } = "";
}
