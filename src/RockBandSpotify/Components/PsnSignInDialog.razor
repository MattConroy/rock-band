@* PlayStation can't hand the app a token the way Spotify can, so this is the
   one place a person has to fetch and paste one themselves. Two steps, each
   with its control on its own line so neither is crowded, and the paste is
   checked as it is typed — a truncated copy is otherwise indistinguishable
   from an expired token once PlayStation rejects it. *@

<div class="dialog-backdrop" @onclick="OnCancel">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="psn-dialog-title"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
        <div class="dialog-head">
            <h2 id="psn-dialog-title">Connect PlayStation</h2>
            <button type="button" class="dialog-close" aria-label="Close" @onclick="OnCancel">✕</button>
        </div>

        <p class="rb-sub dialog-intro">
            This isn't Sony's own app, so it can't read your login directly. The token
            stays in this browser and lasts about two months.
        </p>

        <div class="dialog-step">
            <div class="dialog-step-head">
                <span class="dialog-step-num">1</span>
                <span>Sign in on Sony's site</span>
            </div>
            <a class="rb-btn rb-btn-secondary dialog-step-control"
               href="https://ca.account.sony.com/api/v1/ssocookie"
               target="_blank" rel="noopener">Open PlayStation login ↗</a>
        </div>

        <div class="dialog-step">
            <div class="dialog-step-head">
                <span class="dialog-step-num">2</span>
                <span>Paste what that page shows</span>
            </div>

            <div class="field-wrap">
                <input class="rb-select dialog-step-control dialog-input @FieldClass"
                       type="password" autocomplete="off" spellcheck="false"
                       placeholder="npsso value, or the whole line"
                       aria-describedby="npsso-note"
                       aria-invalid="@(_check.State == NpssoState.Invalid)"
                       value="@_pasted"
                       @oninput="OnInput" />

                @if (_check.State is not NpssoState.Empty)
                {
                    <span class="field-mark @FieldClass" aria-hidden="true">
                        @if (_check.IsValid)
                        {
                            <svg viewBox="0 0 16 16" width="16" height="16">
                                <path fill="none" stroke="currentColor" stroke-width="2.2"
                                      stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 4.8" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" width="16" height="16">
                                <path fill="none" stroke="currentColor" stroke-width="2.2"
                                      stroke-linecap="round" d="M4 4l8 8M12 4l-8 8" />
                            </svg>
                        }
                    </span>
                }
            </div>

            <p id="npsso-note" class="dialog-note @NoteClass" aria-live="polite">@_check.Message</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="rb-alert-bad dialog-error">@Error</p>
        }

        <div class="dialog-actions">
            <button class="rb-btn rb-btn-secondary" @onclick="OnCancel">Cancel</button>
            <button class="rb-btn" disabled="@(!_check.IsValid)" @onclick="Connect">Connect</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnConnect { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? Error { get; set; }

    private string _pasted = string.Empty;
    private NpssoCheck _check = NpssoToken.Check(null);

    private string FieldClass => _check.State switch
    {
        NpssoState.Valid => "field-ok",
        NpssoState.Invalid => "field-bad",
        _ => string.Empty,
    };

    private string NoteClass => _check.State switch
    {
        NpssoState.Valid => "dialog-note-ok",
        NpssoState.Invalid => "dialog-note-bad",
        _ => "rb-sub",
    };

    private void OnInput(ChangeEventArgs e)
    {
        _pasted = e.Value?.ToString() ?? string.Empty;
        _check = NpssoToken.Check(_pasted);
    }

    private async Task Connect()
    {
        if (_check.Token is not null) await OnConnect.InvokeAsync(_check.Token);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Connect();
        else if (e.Key == "Escape") await OnCancel.InvokeAsync();
    }
}
