@* PlayStation can't hand the app a token the way Spotify can, so this is the
   one place a person has to fetch and paste one themselves. *@

<div class="dialog-backdrop" @onclick="OnCancel">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="psn-dialog-title"
         @onclick:stopPropagation="true">
        <h2 id="psn-dialog-title">Connect PlayStation</h2>

        <p class="rb-sub">
            This isn't Sony's own app, so it can't read your login directly. Sign in
            on their site and paste the token it shows. It stays in this browser and
            lasts about two months.
        </p>

        <ol class="dialog-steps">
            <li>
                <a class="rb-btn login-link" href="https://ca.account.sony.com/api/v1/ssocookie"
                   target="_blank" rel="noopener">Open PlayStation login ↗</a>
                <p class="rb-sub">Sign in — the page then shows <code>{"npsso":"…"}</code>.</p>
            </li>
            <li>
                <input class="rb-select dialog-input" type="password" autocomplete="off"
                       placeholder="Paste the npsso value" value="@_npsso"
                       @oninput="e => _npsso = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnKeyDown" />
            </li>
        </ol>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="rb-alert-bad">@Error</p>
        }

        <div class="rb-row-actions dialog-actions">
            <button class="rb-btn" disabled="@(_npsso.Trim().Length == 0)" @onclick="Connect">Connect</button>
            <button class="rb-btn rb-btn-secondary" @onclick="OnCancel">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnConnect { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? Error { get; set; }

    private string _npsso = string.Empty;

    private async Task Connect()
    {
        var token = _npsso.Trim();
        if (token.Length == 0) return;

        // Paste often brings the whole {"npsso":"…"} line rather than the value.
        var quoted = System.Text.RegularExpressions.Regex.Match(token, "\"npsso\"\\s*:\\s*\"([^\"]+)\"");
        if (quoted.Success) token = quoted.Groups[1].Value;

        await OnConnect.InvokeAsync(token);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Connect();
        else if (e.Key == "Escape") await OnCancel.InvokeAsync();
    }
}
