@* Step 4: create/update the playlist with the checked matches. *@

<StepCard Number="4" Title="@($"Sync playlist \"{PlaylistName}\"")">
    <p class="rb-muted">Adds the @SelectedCount checked tracks. Re-running only adds what's missing — no duplicates.</p>
    <button class="rb-btn" @onclick="OnSync" disabled="@(Syncing || SelectedCount == 0)">
        @(Syncing ? "Syncing…" : $"Sync {SelectedCount} tracks")
    </button>

    @if (Result is not null)
    {
        <div class="rb-alert rb-alert-ok result">
            @(Result.Created ? "Created" : "Updated") playlist —
            added <strong>@Result.Added</strong>, @Result.AlreadyPresent already present.
            @if (Result.Playlist.WebUrl is { } url)
            {
                <a href="@url" target="_blank" rel="noopener">Open in Spotify ↗</a>
            }
        </div>
    }
    @if (Error is not null)
    {
        <div class="rb-alert rb-alert-bad result">@Error</div>
    }
</StepCard>

@code {
    [Parameter, EditorRequired] public string PlaylistName { get; set; } = "";
    [Parameter, EditorRequired] public int SelectedCount { get; set; }
    [Parameter, EditorRequired] public bool Syncing { get; set; }
    [Parameter] public SyncResult? Result { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnSync { get; set; }
}
