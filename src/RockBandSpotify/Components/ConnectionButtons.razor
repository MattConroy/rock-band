@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject ConnectionState State
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The two connections, always on screen. Each shows how far along it is and
   presses through to the next useful thing: sign in, fetch or sync, and once
   there is something to show, show it. *@
<div class="conn-buttons">
    @if (State.IsPsnConfigured)
    {
        <button type="button" class="conn-btn @StatusClass(State.Psn) @(State.PsnBusy ? "conn-busy" : "")"
                title="@PsnTitle" aria-label="@PsnTitle" aria-busy="@State.PsnBusy"
                disabled="@State.PsnBusy" @onclick="PressPsnAsync">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M8.984 2.596v17.547l3.915 1.261V6.688c0-.69.304-1.151.794-.991.636.18.76.814.76 1.505v5.875c2.441 1.193 4.362-.002 4.362-3.152 0-3.237-1.126-4.675-4.438-5.827-1.307-.448-3.728-1.186-5.39-1.502zm4.656 16.241l6.296-2.275c.715-.258.826-.625.246-.818-.586-.192-1.637-.139-2.357.123l-4.205 1.5V14.98l.24-.085s1.201-.42 2.913-.615c1.696-.18 3.785.03 5.437.661 1.848.601 2.04 1.472 1.576 2.072-.465.6-1.622 1.036-1.622 1.036l-8.544 3.107V18.86zM1.807 18.6c-1.9-.545-2.214-1.668-1.352-2.32.801-.586 2.16-1.052 2.16-1.052l5.615-2.013v2.313L4.205 17c-.705.271-.825.632-.239.826.586.195 1.637.15 2.343-.12L8.247 17v2.074c-.12.03-.256.044-.39.073-1.939.331-3.996.196-6.038-.479z"/>
            </svg>
            <span class="conn-dot"></span>
        </button>
    }

    @if (State.IsSpotifyConfigured)
    {
        <button type="button" class="conn-btn @StatusClass(State.Spotify) @(State.SpotifyBusy ? "conn-busy" : "")"
                title="@SpotifyTitle" aria-label="@SpotifyTitle" aria-busy="@State.SpotifyBusy"
                disabled="@State.SpotifyBusy" @onclick="PressSpotifyAsync">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
            </svg>
            <span class="conn-dot"></span>
        </button>
    }
</div>

@if (_showPsnDialog)
{
    <PsnSignInDialog OnConnect="ConnectPsnAsync" OnCancel="ClosePsnDialog" Error="@State.Error" />
}
else if (_showPsnStatus)
{
    <PsnStatusDialog OwnedCount="State.OwnedCount" MatchedCount="State.MatchedCount"
                     ShowingOwned="@ShowingOwned" Busy="State.PsnBusy"
                     OnClose="() => _showPsnStatus = false"
                     OnToggleFilter="ToggleOwnedFilter"
                     OnRefetch="State.FetchPsnAsync"
                     OnClear="ClearPsnAsync"
                     OnDisconnect="DisconnectPsnAsync" />
}
else if (!string.IsNullOrEmpty(State.Error))
{
    <div class="conn-error" role="alert">
        <span>@State.Error</span>
        <button type="button" class="conn-error-dismiss" aria-label="Dismiss"
                @onclick="State.ClearError">✕</button>
    </div>
}

@code {
    private bool _showPsnDialog;
    private bool _showPsnStatus;

    /// <summary>Whether the catalogue is currently narrowed to owned songs.</summary>
    private bool ShowingOwned =>
        Nav.ToAbsoluteUri(Nav.Uri).Query.Contains("owned=1", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        // The status dialog reads the filter out of the address, so the button
        // has to redraw when the catalogue changes it — otherwise it keeps
        // offering to undo a filter that is no longer applied.
        Nav.LocationChanged += OnLocationChanged;
        await State.RefreshAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private static string StatusClass(ConnectionStatus status) => status switch
    {
        ConnectionStatus.Synced => "conn-synced",
        ConnectionStatus.Connected => "conn-connected",
        _ => "conn-disconnected",
    };

    private string PsnTitle => State.PsnBusy ? "Fetching your PlayStation library…" : State.Psn switch
    {
        ConnectionStatus.Synced => $"PlayStation · {State.OwnedCount} songs owned. Show only these.",
        ConnectionStatus.Connected => "PlayStation · connected. Fetch your songs.",
        _ => "PlayStation · not connected. Sign in.",
    };

    private string SpotifyTitle => State.SpotifyBusy ? "Syncing your playlist…" : State.Spotify switch
    {
        ConnectionStatus.Synced => "Spotify · playlist synced. Open it.",
        ConnectionStatus.Connected => "Spotify · signed in. Sync your playlist.",
        _ => "Spotify · not connected. Sign in.",
    };

    private async Task PressPsnAsync()
    {
        switch (State.Psn)
        {
            case ConnectionStatus.Disconnected:
                _showPsnDialog = true;
                break;
            case ConnectionStatus.Connected:
                await State.FetchPsnAsync();
                break;
            case ConnectionStatus.Synced:
                _showPsnStatus = true;
                break;
        }
    }

    private void ClosePsnDialog()
    {
        _showPsnDialog = false;
        State.ClearError();
    }

    private async Task ConnectPsnAsync(string npsso)
    {
        _showPsnDialog = false;
        await State.ConnectPsnAsync(npsso);
    }

    /// <summary>
    /// Adds or removes the filter rather than only setting it — the old
    /// behaviour navigated to an address it was already on, so a second press
    /// did nothing and there was no way back to the full catalogue.
    /// </summary>
    private void ToggleOwnedFilter()
    {
        _showPsnStatus = false;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("owned", ShowingOwned ? null : "1"));
    }

    private async Task ClearPsnAsync()
    {
        _showPsnStatus = false;
        if (ShowingOwned) Nav.NavigateTo(Nav.GetUriWithQueryParameter("owned", (string?)null));
        await State.ClearPsnSongsAsync();
    }

    private async Task DisconnectPsnAsync()
    {
        _showPsnStatus = false;
        if (ShowingOwned) Nav.NavigateTo(Nav.GetUriWithQueryParameter("owned", (string?)null));
        await State.DisconnectPsnAsync();
    }

    private async Task PressSpotifyAsync()
    {
        switch (State.Spotify)
        {
            case ConnectionStatus.Disconnected:
                await State.SignInToSpotifyAsync();
                break;
            case ConnectionStatus.Connected:
                await State.SyncSpotifyAsync();
                break;
            case ConnectionStatus.Synced when State.PlaylistUrl is not null:
                await JS.InvokeVoidAsync("rbSpotify.openInNewTab", State.PlaylistUrl);
                break;
        }
    }
}
