@* Renders a match's confidence as a coloured pill. *@

@if (Match.Status == MatchStatus.Matched)
{
    <span class="rb-pill @CssClass">@Label</span>
}

@code {
    [Parameter, EditorRequired] public SongMatch Match { get; set; } = default!;

    private (string Css, string Text) Display => Match.Confidence switch
    {
        >= 0.75 => ("rb-pill-ok", "High"),
        >= 0.5 => ("rb-pill-ok", "Good"),
        >= 0.3 => ("rb-pill-warn", "Low"),
        _ => ("rb-pill-bad", "Very low")
    };

    private string CssClass => Display.Css;
    private string Label => Display.Text;
}
