@* Step 3: kick off matching and show progress. *@

<StepCard Number="3" Title="Match to Spotify tracks">
    <p class="rb-muted">Searches Spotify for each song. Low-confidence matches are unchecked by default — review them before syncing.</p>
    <button class="rb-btn" @onclick="OnMatch" disabled="@(!CanMatch || Matching)">
        @(Matching ? "Matching…" : "Match songs")
    </button>

    @if (Matching || Matches.Count > 0)
    {
        <div class="progress-block">
            <div class="progress">
                <div class="progress-bar" style="width:@(ProgressPct)%"></div>
            </div>
            <p class="rb-sub tally">
                @ProgressDone / @ProgressTotal searched
                @if (Matches.Count > 0)
                {
                    <span>· @MatchedCount matched · @NeedsReviewCount need review · @NoResultCount no result</span>
                }
            </p>
        </div>
    }
</StepCard>

@code {
    [Parameter, EditorRequired] public bool CanMatch { get; set; }
    [Parameter, EditorRequired] public bool Matching { get; set; }
    [Parameter, EditorRequired] public int ProgressDone { get; set; }
    [Parameter, EditorRequired] public int ProgressTotal { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<SongMatch> Matches { get; set; } = Array.Empty<SongMatch>();
    [Parameter] public EventCallback OnMatch { get; set; }

    private int ProgressPct => ProgressTotal == 0 ? 0 : (int)(100.0 * ProgressDone / ProgressTotal);
    private int MatchedCount => Matches.Count(m => m.Status == MatchStatus.Matched);
    private int NoResultCount => Matches.Count(m => m.Status == MatchStatus.NoResults);
    private int NeedsReviewCount => Matches.Count(m => m.Status == MatchStatus.Matched && m.Confidence < 0.5);
}
