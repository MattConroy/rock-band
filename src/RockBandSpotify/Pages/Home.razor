@page "/"

<PageTitle>Rock Band → Spotify</PageTitle>

<SetupBanner SpotifyConfigured="Auth.IsConfigured"
             GatewayConfigured="Psn.IsGatewayConfigured"
             RedirectUri="@Auth.RedirectUri" />

<SpotifyConnectCard SignedIn="_signedIn"
                    UserName="@SpotifyUserName"
                    Configured="Auth.IsConfigured"
                    OnLogin="LoginSpotifyAsync"
                    OnLogout="LogoutSpotifyAsync" />

<PsnConnectCard Connected="_psnConnected"
                Library="_library"
                Fetching="_fetching"
                Error="@_psnError"
                GatewayConfigured="Psn.IsGatewayConfigured"
                SsoUrl="@Psn.SsoCookieUrl"
                RawDebug="@_rawDebug"
                LoadingRaw="_loadingRaw"
                OnConnect="ConnectPsnAsync"
                OnFetch="FetchSongsAsync"
                OnDisconnect="DisconnectPsnAsync"
                OnLoadRaw="LoadRawDebugAsync" />

<MatchCard CanMatch="CanMatch"
           Matching="_matching"
           ProgressDone="_progressDone"
           ProgressTotal="_progressTotal"
           Matches="_matches"
           OnMatch="MatchAsync" />

@if (_matches.Count > 0)
{
    <MatchReviewCard Matches="_matches" OnChanged="StateHasChanged" />

    <SyncCard PlaylistName="@PlaylistCfg.Name"
              SelectedCount="SelectedCount"
              Syncing="_syncing"
              Result="_syncResult"
              Error="@_error"
              OnSync="SyncAsync" />
}
