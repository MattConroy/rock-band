@page "/"
@page "/catalogue"

<PageTitle>Song catalogue — Rock Band → Spotify</PageTitle>

<div class="rb-card">
    <div class="filter-bar">
        <div class="search-box">
            <input class="rb-select search" type="search" placeholder="Search song or artist…"
                   value="@_search" @oninput="OnSearchChanged" />
            @if (_search.Length > 0)
            {
                <button type="button" class="search-clear" title="Clear search" @onclick="ClearSearch">×</button>
            }
        </div>

        <div class="select-group">
            <select class="rb-select" @onchange="OnGenreChanged">
                <option value="">All genres</option>
                @foreach (var g in _genres)
                {
                    <option value="@g" selected="@(g == _genre)">@g</option>
                }
            </select>

            <select class="rb-select" @onchange="OnSourceChanged">
                <option value="">All sources</option>
                @foreach (var src in _sources)
                {
                    <option value="@src" selected="@(src == _source)">@SourceCatalog.Name(src)</option>
                }
            </select>

            @* Nothing to compare against until PlayStation has been fetched once. *@
            @if (HasOwnedLibrary)
            {
                <select class="rb-select" @onchange="OnOwnedChanged" aria-label="Ownership">
                    <option value="Any" selected="@(_owned == OwnedFilter.Any)">All songs</option>
                    <option value="Owned" selected="@(_owned == OwnedFilter.Owned)">Owned</option>
                    <option value="NotOwned" selected="@(_owned == OwnedFilter.NotOwned)">Unowned</option>
                </select>
            }
        </div>

        @if (HasFilters)
        {
            <button class="rb-btn rb-btn-secondary" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

    <div class="rb-row-actions result-row">
        <span class="rb-muted">@_filtered.Count shown</span>

        <div class="column-picker">
            <button type="button" class="icon-btn" @onclick="ToggleColumnPicker"
                    title="Choose columns" aria-label="Choose columns">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <rect x="1" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                    <rect x="6.25" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                    <rect x="11.5" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                </svg>
            </button>
            @if (_showColumnPicker)
            {
                <div class="column-picker-menu">
                    @foreach (var col in OptionalColumns)
                    {
                        <label>
                            <input type="checkbox" checked="@_visibleColumns.Contains(col.Key)"
                                   @onchange="_ => ToggleColumn(col.Key)" />
                            @col.Label
                        </label>
                    }
                </div>
            }
        </div>
    </div>

    <div class="table-wrap">
        <div class="table-header-wrap" id="rb-table-header">
            <table class="catalogue-table" style="@TableMinWidth">
                <thead>
                    <tr>
                        @if (HasOwnedLibrary)
                        {
                            @* A tick rather than a word: the column is one
                               glyph wide, and "OWN" could not fit beside a
                               sort arrow without clipping. *@
                            <th class="col-owned" aria-sort='@AriaSort("Owned")'>
                                <button type="button" class="th-sort-btn" title="Owned"
                                        aria-label="Sort by owned" @onclick='() => ToggleSort("Owned")'>
                                    &#10003;<span class="sort-indicator">@SortIndicator("Owned")</span>
                                </button>
                            </th>
                        }
                        <th class="col-song" aria-sort='@AriaSort("Song")'>
                            <button type="button" class="th-sort-btn" @onclick='() => ToggleSort("Song")'>
                                Song<span class="sort-indicator">@SortIndicator("Song")</span>
                            </button>
                        </th>
                        <th class="col-artist" aria-sort='@AriaSort("Artist")'>
                            <button type="button" class="th-sort-btn" @onclick='() => ToggleSort("Artist")'>
                                Artist<span class="sort-indicator">@SortIndicator("Artist")</span>
                            </button>
                        </th>
                        @foreach (var col in OptionalColumns)
                        {
                            if (_visibleColumns.Contains(col.Key))
                            {
                                <th class="col-@col.Key.ToLowerInvariant()" aria-sort="@AriaSort(col.Key)">
                                    <button type="button" class="th-sort-btn" @onclick="() => ToggleSort(col.Key)">
                                        @col.Label<span class="sort-indicator">@SortIndicator(col.Key)</span>
                                    </button>
                                </th>
                            }
                        }
                    </tr>
                </thead>
            </table>
        </div>
        <div class="table-body-wrap" id="rb-table-body">
            <table class="catalogue-table" style="@TableMinWidth">
                <tbody>
                    @foreach (var s in _filtered)
                    {
                        <tr>
                            @if (HasOwnedLibrary)
                            {
                                <td class="col-owned">
                                    @if (_ownedIds.Contains(s.Id))
                                    {
                                        <span class="owned-tick" title="In your library" aria-label="owned">&#10003;</span>
                                    }
                                </td>
                            }
                            <td class="col-song">@s.Song</td>
                            <td class="col-artist">@s.Artist</td>
                            @foreach (var col in OptionalColumns)
                            {
                                if (_visibleColumns.Contains(col.Key))
                                {
                                    <td class="col-@col.Key.ToLowerInvariant()">@col.Value(s)</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
