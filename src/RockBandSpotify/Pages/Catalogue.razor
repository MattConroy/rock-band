@page "/"
@page "/catalogue"

<PageTitle>Song catalogue — Rock Band → Spotify</PageTitle>

<div class="rb-card">
    <div class="filter-bar">
        <div class="search-box">
            <input class="rb-select search" type="search" placeholder="Search song or artist…"
                   value="@_search" @oninput="OnSearchChanged" />
            @if (_search.Length > 0)
            {
                <button type="button" class="search-clear" title="Clear search" @onclick="ClearSearch">×</button>
            }
        </div>

        <div class="select-group">
            <select class="rb-select" @onchange="OnGenreChanged">
                <option value="">All genres</option>
                @foreach (var g in _genres)
                {
                    <option value="@g" selected="@(g == _genre)">@g</option>
                }
            </select>

            <select class="rb-select" @onchange="OnSourceChanged">
                <option value="">All sources</option>
                @foreach (var src in _sources)
                {
                    <option value="@src" selected="@(src == _source)">@SourceCatalog.Name(src)</option>
                }
            </select>
        </div>

        @if (HasFilters)
        {
            <button class="rb-btn rb-btn-secondary" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

    <div class="rb-row-actions result-row">
        <span class="rb-muted">@_filtered.Count shown</span>

        <div class="column-picker">
            <button type="button" class="icon-btn" @onclick="ToggleColumnPicker"
                    title="Choose columns" aria-label="Choose columns">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <rect x="1" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                    <rect x="6.25" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                    <rect x="11.5" y="2" width="3.5" height="12" rx="1" fill="currentColor" />
                </svg>
            </button>
            @if (_showColumnPicker)
            {
                <div class="column-picker-menu">
                    @foreach (var col in OptionalColumns)
                    {
                        <label>
                            <input type="checkbox" checked="@_visibleColumns.Contains(col.Key)"
                                   @onchange="_ => ToggleColumn(col.Key)" />
                            @col.Label
                        </label>
                    }
                </div>
            }
        </div>
    </div>

    <div class="table-wrap">
        <table class="catalogue-table">
            <thead>
                <tr>
                    <th>Song</th>
                    <th>Artist</th>
                    @foreach (var col in OptionalColumns)
                    {
                        if (_visibleColumns.Contains(col.Key))
                        {
                            <th>@col.Label</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="_filtered" Context="s" ItemSize="33">
                    <tr>
                        <td>@s.Song</td>
                        <td>@s.Artist</td>
                        @foreach (var col in OptionalColumns)
                        {
                            if (_visibleColumns.Contains(col.Key))
                            {
                                <td title="@col.Title?.Invoke(s)">@col.Value(s)</td>
                            }
                        }
                    </tr>
                </Virtualize>
            </tbody>
        </table>
    </div>
</div>
